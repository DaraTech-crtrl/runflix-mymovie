# Movie API
VITE_API_KEY="your_api_key_here"
# Optional: override dev proxy target (default: https://movieapi.gifted.co.ke)
# VITE_API_PROXY_TARGET="https://movieapi.gifted.co.ke"

# Public site URL (used for OG images, canonical links)
VITE_SITE_URL="https://runflix.name.ng"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server-only admin PIN (set in cPanel env — never put in VITE_ vars)
# MAINTENANCE_ADMIN_KEY="your_secret_pin"
