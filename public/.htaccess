<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Handle error pages
  ErrorDocument 403 /403.html
  ErrorDocument 404 /404.html
  ErrorDocument 500 /500.html
  ErrorDocument 503 /503.html

  # Route all /api/v2/ calls to the local PHP proxy to bypass Origin blocking
  RewriteRule ^api/v2/(.*)$ api_proxy.php [L,QSA]

  # Route all /img-proxy calls to the local PHP image proxy
  RewriteRule ^img-proxy$ img_proxy.php [L,QSA]

  # Route contact form submissions to the SMTP mailer
  RewriteRule ^api/contact$ contact_mailer.php [L]

  # If the requested file or directory exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise, route everything else to meta.php for React Router to handle (including dynamic SEO injection)
  RewriteRule . /meta.php [L]
</IfModule>

# Caching for JavaScript and CSS
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpg|jpeg|svg|ico|woff2)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # HSTS Support
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>
